{
  "name": "optiv-fairr-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Optiv Frontier AI Readiness & Resilience practice: business plan, financial model, and interactive planning app built on CrowdStrike Falcon IQ / Project QuiltWorks",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "model": "tsx model/cli.ts",
    "model:xlsx": "tsx model/build-xlsx.ts",
    "model:validate": "tsx model/validate.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "hyperformula": "^3.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  }
}
